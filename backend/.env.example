# Database Connection (Prisma)
DATABASE_URL="postgresql://postgres:dockerpassword@localhost:5432/ratingflix?schema=public"

# Authentication
JWT_SECRET="secret-key-change-me-in-production"

# TMDB API (https://www.themoviedb.org/settings/api -> API Read Access Token)
# Required for /movies/search and /movies/:mediaType/:id to return real data.
TMDB_API_BEARER_TOKEN=""
